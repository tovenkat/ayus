# Template for ANOTHER domain/app on the same droplet.
# Run that app so it publishes a UNIQUE localhost port (e.g. 127.0.0.1:3001),
# copy this to /etc/nginx/sites-available/<domain>, adjust server_name + port,
# enable it, then: sudo certbot --nginx -d <domain>
server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    client_max_body_size 25M;

    location / {
        proxy_pass http://127.0.0.1:3001;          # this app's localhost port
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
    }
}
