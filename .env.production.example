# ── Ayus production .env (copy to .env on the droplet; never commit) ──────────
# Compose interpolates ${...} from this file. Generate secrets with:
#   openssl rand -base64 32

# Public URL / TLS
DOMAIN=ayus.example.com                 # Caddy serves HTTPS for this. Use ":80" for an IP-only HTTP test.
NEXTAUTH_URL=https://ayus.example.com
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# Encrypts secrets at rest (per-account BYOK API keys). REQUIRED in production —
# the app throws without it. Generate with:  openssl rand -hex 32
# Do NOT change it after keys are saved, or they can't be decrypted.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# Postgres (compose builds DATABASE_URL from these; runs inside the stack)
POSTGRES_USER=ayus
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=ayus
# DATABASE_URL is injected by docker-compose — do not set it here.

# Deploy / GitHub webhook
DEPLOY_BRANCH=main
WEBHOOK_SECRET=CHANGE_ME_random_hex
WEBHOOK_PORT=9000

# Seed reference biomarkers + demo accounts/data on the FIRST deploy (fresh DB).
# ⚠ Demo logins are phone +91000000000X with OTP 123456 — fine for a demo/staging,
#   but set to false (and remove the demo accounts) for a real production launch.
SEED_DEMO=true

# Pre-fill the demo OTP (123456) in the login UI so reviewers can just click
# "Sign in". ONLY affects demo phones (+91000…, +1555…, +919999999999); real
# OTPs are never surfaced. Leave false/unset for a real production launch.
DEMO_OTP_AUTOFILL=true

# Compute: cpu (default) or gpu (needs an NVIDIA droplet + Container Toolkit)
COMPUTE_MODE=cpu

# Reverse proxy: caddy (default, single domain, auto-HTTPS in-stack) or nginx
# (host Nginx fronts multiple domains — app publishes 127.0.0.1:${APP_PORT}).
# See deploy/MULTI-DOMAIN.md.
REVERSE_PROXY=caddy
APP_PORT=3000

# ── AI: local Ollama (runs as the "ollama" compose service) ───────────────────
# Leave INTERNET_LLM empty for local. New orgs default to OLLAMA_LOCAL (schema).
# For a cloud default (better medical accuracy), set the provider + its key +
# optional model, e.g.:
#   INTERNET_LLM=CLAUDE
#   CLAUDE_API_KEY=sk-ant-...
#   INTERNET_LLM_MODEL=claude-sonnet-5        # omit → provider default
#   — or — INTERNET_LLM=GEMINI / GEMINI_API_KEY=... / INTERNET_LLM_MODEL=gemini-2.5-pro
INTERNET_LLM=
# INTERNET_LLM_MODEL=
# By default extraction/OCR stay LOCAL even when INTERNET_LLM is set (raw reports
# are PHI). Set true to also run document extraction on the cloud provider —
# better accuracy on messy/long reports. Turn off to go back to local extraction.
CLOUD_EXTRACTION=false
#
# Second-opinion reviewer: re-check only the LOW-confidence extracted fields
# with a stronger model (Claude by default), independent of the primary
# extractor. Off by default. Needs a key for the chosen reviewer provider
# (CLAUDE_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY). Anything the reviewer
# still can't verify stays in the human review queue.
REVIEW_LOW_CONFIDENCE=false
#
# Completeness safeguard: after extraction, re-check the source text for tests
# the model MISSED (long reports sometimes drop tests on the last pages) and
# merge them in before saving. Model-agnostic. Adds one extra LLM call per
# upload (accuracy-for-cost). Recommended when accuracy on long reports matters.
EXTRACTION_COMPLETENESS_CHECK=false
# REVIEWER_PROVIDER=CLAUDE          # CLAUDE | OPENAI | GEMINI
# REVIEW_MODEL=claude-sonnet-5      # omit → provider default
# REVIEW_CONFIDENCE_MAX=0.8         # only rows below this get a second opinion
OLLAMA=YES
# OLLAMA_HOST is injected by compose (http://ollama:11434).
#
# CPU-lean defaults (COMPUTE_MODE=cpu): a 3B extractor keeps a report to seconds,
# not minutes. OCR only runs on scanned PDFs (EXTRACTION_STRATEGY=auto lets
# Docling/pdf-parse handle text-native ones), so deepseek-ocr's cost is rare.
# Chat/RAG uses a small 1.5B model so replies stream fast on CPU. Extraction
# keeps the 3B (accuracy matters more there, and it only runs on upload).
CHAT_MODEL=qwen2.5:1.5b
EXTRACT_MODEL=qwen2.5:3b
OCR_MODEL=deepseek-ocr:latest
# Keep nomic-embed-text — its 768-dim output matches the pgvector column.
EMBED_MODEL=nomic-embed-text
# Models deploy.sh pulls into Ollama (space-separated).
OLLAMA_MODELS=qwen2.5:1.5b qwen2.5:3b deepseek-ocr:latest nomic-embed-text
#
# Higher-quality preset (more RAM, or COMPUTE_MODE=gpu): raise to 7B.
#   CHAT_MODEL=qwen2.5:7b-instruct
#   EXTRACT_MODEL=qwen2.5:7b-instruct
#   OLLAMA_MODELS=qwen2.5:7b-instruct deepseek-ocr:latest nomic-embed-text
EXTRACTION_STRATEGY=auto
# GLiNER-BioMed NER for clinical text (prescriptions / doctor notes / imaging).
# Set true to run the sidecar: deploy.sh builds + starts it (compose "gliner"
# profile) and the app reaches it at http://gliner:8001 automatically. First
# build pulls PyTorch; first start downloads ~500 MB of weights. Needs RAM —
# fine on an 8 GB+ droplet, leave false on small ones. Runs on CPU by default
# (set GLINER_DEVICE=cuda on a GPU droplet).
ENABLE_GLINER=false
# GLINER_DEVICE=cpu
VECTOR_DB=pgvector

# ── Chat / RAG latency (CPU-tuned) ────────────────────────────────────────────
# On CPU the chat model's token generation dominates. These keep it responsive:
#   OLLAMA_KEEP_ALIVE        -1 = keep models resident forever (no reload cost).
#   OLLAMA_MAX_LOADED_MODELS 2  = hold chat + embed models at once (no swap
#                                 thrash mid-request). Raise if you add OCR to chat.
#   OLLAMA_NUM_PARALLEL      1  = one generation at a time (don't split 2 vCPUs).
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1
# Smaller retrieved context = faster first token. RAG_CHUNK_LIMIT chunks, each
# capped to RAG_CHUNK_CHARS characters.
RAG_CHUNK_LIMIT=4
RAG_CHUNK_CHARS=800
# Cap the chat context window and answer length (bounds worst-case latency).
CHAT_NUM_CTX=4096
CHAT_NUM_PREDICT=512

# ── Storage (PHI): persistent volume, set by compose ──────────────────────────
UPLOADS_DIR=/data/uploads

# ── Backups (deploy/backup.sh via the systemd timer) ──────────────────────────
BACKUP_RETAIN_DAYS=14
# Optional off-box copy to DO Spaces (S3). Needs the aws CLI + credentials on the
# host (~/.aws or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env).
# SPACES_BUCKET=ayus-backups
# SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com

# ── Feedback → email ──────────────────────────────────────────────────────────
FEEDBACK_EMAIL=team@yourdomain.com
EMAIL_FROM=Ayus <feedback@yourdomain.com>
# RESEND_API_KEY=
# Extra feedback-log admins. For the demo, the seeded org owners can triage:
# FEEDBACK_ADMIN_EMAILS=910000000010@phone.local,910000000020@phone.local,910000000030@phone.local

# ── Optional: WhatsApp/SMS (Twilio) ───────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
