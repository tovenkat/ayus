DATABASE_URL="postgresql://venkat@localhost:5432/phr2_dev"
AUTH_SECRET=changeme-generate-a-real-secret
NEXTAUTH_URL=http://localhost:3001

# AI Provider — pick ONE: GEMINI | OPENAI | CLAUDE
INTERNET_LLM=GEMINI
# INTERNET_LLM_MODEL=gemini-2.5-flash

# Gemini
# GEMINI_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Claude
# ANTHROPIC_API_KEY=

# Ollama (local)
# OLLAMA_HOST=http://localhost:11434
# CHAT_MODEL=gemma3:4b
# EMBED_MODEL=nomic-embed-text

# Vector DB: none | lancedb
VECTOR_DB=lancedb
LANCEDB_PATH=.lancedb

# ── Biomedical NER (GLiNER-BioMed) sidecar — narrative clinical text only ──
# Opt-in; inert until ENABLE_GLINER=true and scripts/gliner-sidecar is running.
ENABLE_GLINER=false
GLINER_SIDECAR_URL=http://localhost:8001
GLINER_MODEL=Ihor/gliner-biomed-base-v1.0
GLINER_THRESHOLD=0.5
GLINER_LABELS=lab test,biomarker,disease,medication,anatomical site
GLINER_DEVICE=cpu

# In-app feedback → email (feedback is stored regardless; emailed when a provider is set)
FEEDBACK_EMAIL=team@yourdomain.com
EMAIL_FROM=Ayus <feedback@yourdomain.com>
# RESEND_API_KEY=
